    "/api/v1/served-unserved/rollups/": {
      "get": {
        "description": "Stored 100/20 Mbps counts ordered by area code. H3 rows sum contributing states before pagination. Geometry is separate. Links pin resolved release dates, but separate pages are fresh reads and may change after replacement or rebuilding.",
        "operationId": "served_unserved_rollups_list",
        "parameters": [
          {
            "description": "Data period in YYYY-MM-DD form. Supply both dates or neither; omission selects latest.",
            "in": "query",
            "name": "as_of",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "Optional GEOID or lowercase H3 cell matching the selected level's AREA_KEYS form.",
            "in": "query",
            "name": "code",
            "schema": {
              "maxLength": 15,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "* `any` - any\n* `wired` - wired\n* `terrestrial` - terrestrial",
            "in": "query",
            "name": "flag",
            "schema": {
              "default": "wired",
              "enum": [
                "any",
                "wired",
                "terrestrial"
              ],
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "* `county` - County\n* `tract` - Census tract\n* `block_group` - Block group\n* `block` - Census block\n* `h3_res8` - H3 resolution-8 cell\n* `place` - Place\n* `county_subdivision` - County subdivision",
            "in": "query",
            "name": "level",
            "required": true,
            "schema": {
              "enum": [
                "county",
                "tract",
                "block_group",
                "block",
                "h3_res8",
                "place",
                "county_subdivision"
              ],
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "default": 100,
              "maximum": 1000,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "FCC processing date in YYYY-MM-DD form; requires as_of.",
            "in": "query",
            "name": "processed_on",
            "schema": {
              "format": "date",
              "type": "string"
            }
          },
          {
            "description": "Optional state FIPS code. For H3, limits contributions rather than cell containment.",
            "in": "query",
            "name": "state",
            "schema": {
              "maxLength": 2,
              "minLength": 2,
              "pattern": "^[0-9]{2}$",
              "type": "string"
            }
          }
        ],
