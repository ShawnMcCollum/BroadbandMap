# Copy this file to .env and adjust as needed. .env is never committed.
# Every value has a working default for local development.

# PostgreSQL / PostGIS
POSTGRES_DB=broadbandmap
POSTGRES_USER=broadbandmap
POSTGRES_PASSWORD=broadbandmap

# Django
# Generate a real key for anything other than local development.
DJANGO_SECRET_KEY=dev-only-insecure-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Host ports
BACKEND_PORT=8000
WEB_PORT=5173
DASHBOARD_PORT=8501

# Optional browser-reachable dashboard URL for remote deployments. If unset,
# the web app uses http://localhost:${DASHBOARD_PORT:-8501}/. Restart/rebuild web after changes.
# VITE_DASHBOARD_URL=https://analysis.example.test/

# Optional browser-reachable React base URL for dashboard navigation. If unset,
# follows WEB_PORT. Use HTTP(S), without credentials, query or fragment.
# WEB_APP_URL=https://map.example.test/
